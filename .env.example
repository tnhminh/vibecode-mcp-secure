# Target repository that ChatGPT is allowed to modify.
VIBECODE_WORKSPACE=E:\\projects\\your-project

# Local MCP listen settings. Keep host on loopback.
VIBECODE_HOST=127.0.0.1
VIBECODE_PORT=1167

# OpenAI Secure MCP Tunnel metadata. Runtime API key is NOT stored here; VibecodeMCP.exe can protect it with Windows DPAPI under .runtime.
CONTROL_PLANE_TUNNEL_ID=tunnel_REPLACE_ME
TUNNEL_ALIAS=vibecode-local

# Shell policy: allowlist (recommended) or workspace-trusted.
VIBECODE_SHELL_MODE=allowlist
VIBECODE_ALLOW_DANGEROUS=0

# Browser defaults to localhost/127.0.0.1 only.
VIBECODE_BROWSER_ALLOW_EXTERNAL=0

# Tool output limits.
VIBECODE_MAX_READ_BYTES=262144
VIBECODE_MAX_COMMAND_OUTPUT_BYTES=262144
